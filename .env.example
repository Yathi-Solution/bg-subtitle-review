# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Azure OpenAI (translation + AI review) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
# An API version, NOT a model version date (e.g. 2025-08-07 returns 404).
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# --- Azure AI Speech (speech-to-text for audio uploads) ---
# A Speech resource on the Standard (S0) tier — Free (F0) has no fast transcription.
# Region: centralindia (Azure Speech is not available in southindia).
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralindia
# Or give the resource's endpoint instead of the region:
# AZURE_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com
# Empty = standard Telugu model (GA). MAI-Transcribe-2 = newer Microsoft model (preview).
# AZURE_SPEECH_MODEL=MAI-Transcribe-2

# --- Web app access ---
# A single shared password that gates the web UI. Use a long random string.
APP_PASSWORD=change-me-to-a-long-random-string

# --- YouTube playlist dashboard (optional; the app works without it) ---
# Neon Postgres: copy both strings from the Neon console (Connect). The pooled one
# (host contains "-pooler") is used by the app; the direct one only by migrations
# (`alembic upgrade head`).
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# YouTube Data API v3 key (public data only) and the playlist to track (ID or URL).
# YOUTUBE_API_KEY=your-youtube-data-api-key
# YOUTUBE_PLAYLIST_ID=PLxxxxxxxxxxxxxxxx
# YOUTUBE_AUDIO_LANG=te          # preferred audio language when no track is marked original
# YOUTUBE_CONTEXT_HINT=          # names/terms sent to Azure Speech for playlist videos
# YOUTUBE_MAX_CONCURRENT=1       # YouTube downloads at a time
# YOUTUBE_AUTO_SYNC_HOURS=0      # also re-read the playlist every N hours (0 = Sync button only)

# --- Optional ---
# RETENTION_HOURS=168         # jobs and their files are deleted this long after upload (7 days)
# JOBS_DIR=./jobs             # where job files live
# MAX_UPLOAD_BYTES=2097152    # max subtitle upload (default 2 MB)
# MAX_AUDIO_BYTES=314572800   # max audio upload (default 300 MB)
# LLM_WORKERS=4               # parallel Azure OpenAI requests for translation / AI review
# PORT=8000                   # local port (Render sets this automatically)
